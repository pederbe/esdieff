{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended"
  ],
  "enabledManagers": [
    "cargo",
    "rust-toolchain",
    "npm",
    "github-actions",
    "dockerfile",
    "custom.regex"
  ],
  "ignorePaths": [
    "**/target/**",
    "**/node_modules/**"
  ],
  "rangeStrategy": "bump",
  "ignoreUnstable": true,
  "minimumReleaseAge": "0 days",
  "separateMajorMinor": false,
  "separateMinorPatch": false,
  "prConcurrentLimit": 1,
  "prHourlyLimit": 0,
  "dependencyDashboard": false,
  "automerge": true,
  "automergeType": "pr",
  "platformAutomerge": true,
  "ignoreTests": false,
  "timezone": "Europe/Berlin",
  "schedule": ["at any time"],
  "updateNotScheduled": true,
  "customManagers": [
    {
      "customType": "regex",
      "managerFilePatterns": ["/^\\.github/workflows/.*\\.yml$/"],
      "matchStrings": ["tool: git-cliff@(?<currentValue>\\d+\\.\\d+\\.\\d+)"],
      "depNameTemplate": "git-cliff",
      "packageNameTemplate": "orhun/git-cliff",
      "datasourceTemplate": "github-releases",
      "versioningTemplate": "semver",
      "extractVersionTemplate": "^v(?<version>.+)$"
    }
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "*"
      ],
      "groupName": "daily dependencies",
      "groupSlug": "daily-dependencies",
      "separateMajorMinor": false
    }
  ],
  "postUpgradeTasks": {
    "commands": ["bash .github/scripts/renovate-sync.sh"],
    "fileFilters": ["site/landing.css"],
    "executionMode": "branch"
  },
  "lockFileMaintenance": {
    "enabled": true,
    "schedule": [
      "at any time"
    ]
  }
}
