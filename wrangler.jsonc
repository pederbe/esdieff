// The Esdieff website: static assets served by Cloudflare Workers, no Worker script.
// scripts/build-site.sh produces target/site. Deployment to esdieff.com is a launch step.
{
  "$schema": "./tools/site/node_modules/wrangler/config-schema.json",
  "name": "esdieff-site",
  "compatibility_date": "2026-10-02",
  "assets": {
    "directory": "./target/site",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  "workers_dev": false,
  "preview_urls": false,
  "routes": [{ "pattern": "esdieff.com", "custom_domain": true }]
}
