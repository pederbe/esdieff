{
  "info": {
    "title": "Door lock with state and numeric PIN"
  },
  "sdfObject": {
    "Lock": {
      "sdfProperty": {
        "state": {
          "type": "string",
          "nullable": false,
          "enum": [
            "locked",
            "unlocked"
          ],
          "readable": true,
          "writable": false
        },
        "credential": {
          "description": "An example PIN, not a real access credential",
          "type": "string",
          "nullable": false,
          "minLength": 4,
          "maxLength": 8,
          "pattern": "^[0-9]+$"
        }
      }
    }
  }
}
