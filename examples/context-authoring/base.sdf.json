          "type": "string",
          "label": "Site name",
          "description": "Installation name",
          "minLength": 1,
          "const": "Office",
          "nullable": false
        },
        "retired": { "type": "string", "nullable": false }
      },
      "sdfProperty": { "temperature": { "type": "number", "unit": "Cel" } }
    }
  }
}
