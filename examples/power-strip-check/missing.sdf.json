{
  "info": { "title": "Power strip needing an absent meter dependency" },
  "namespace": { "meter": "https://example.test/power-meter" },
  "sdfThing": {
    "PowerStrip": {
      "sdfObject": {
        "outlet": {
          "minItems": 2,
          "maxItems": 4,
          "sdfProperty": { "on": { "type": "boolean", "nullable": false } }
        }
      },
      "sdfProperty": {
        "totalPower": { "sdfRef": "meter:#/sdfData/Power", "maximum": 1800 }
      }
    }
  }
}
